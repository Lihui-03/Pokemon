# Discord application token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Server id. Right-click the server icon with Developer Mode on, then Copy Server ID.
# Commands show up immediately in this server.
DISCORD_GUILD_ID=

# Optional role to mention on each restock. Copy Role ID the same way.
ALERT_ROLE_ID=

# Pickup stock uses this Target store. 223 is Milwaukee Chase (2950 S Chase Ave).
# Online shipping stock does not depend on the store.
TARGET_ZIP=53202
TARGET_STORE_ID=223

# Free key from https://developer.bestbuy.com — Best Buy stays unchecked without it.
BESTBUY_API_KEY=

# Seconds between full checks, between discovery searches, and between requests.
# Checks faster than 60 seconds are slowed to 60.
POLL_SECONDS=120
DISCOVERY_SECONDS=900
REQUEST_GAP_SECONDS=2
BLOCK_COOLDOWN_SECONDS=900

# Checkout buys one Target 30th Celebration Elite Trainer Box (1010892076).
# Leave AUTO_PURCHASE false for alerts only. A real order also needs PURCHASE_DRY_RUN=false.
# Shipping is used when it is available. Pickup is used only when shipping is not.
# The saved address or pickup store must show TARGET_ZIP. Sign in once with login.py.
# MAX_ORDER_TOTAL is the most you will pay, including tax and shipping.
AUTO_PURCHASE=false
PURCHASE_DRY_RUN=true
MAX_ORDER_TOTAL=
# PLAYWRIGHT_PROFILE_DIR=data/target-profile
# BROWSER_CHANNEL=chrome
